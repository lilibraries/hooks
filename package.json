{
  "name": "@lilib/hooks",
  "version": "1.1.0",
  "description": "React hook library.",
  "keywords": [
    "react",
    "hooks"
  ],
  "author": {
    "name": "李蔚生 (LeeWeisheng)",
    "url": "https://github.com/LeeWeisheng"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilibraries/hooks.git"
  },
  "bugs": {
    "url": "https://github.com/lilibraries/hooks/issues"
  },
  "homepage": "https://lilibraries.github.io/hooks/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "unpkg": "dist/umd/index.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "husky",
    "start": "npm run dev",
    "dev": "docusaurus start",
    "build": "docusaurus build",
    "test": "concurrently --kill-others-on-fail npm:test:*",
    "test:react16": "node scripts/prepareTestDeps.mjs react16 && cross-env REACT_VERSION=16 jest",
    "test:react17": "node scripts/prepareTestDeps.mjs react17 && cross-env REACT_VERSION=17 jest",
    "test:react18": "node scripts/prepareTestDeps.mjs react18 && cross-env REACT_VERSION=18 jest",
    "test:react19": "jest",
    "lint": "tsc -p tsconfig.json && eslint . --max-warnings 0 && prettier --check . --log-level warn",
    "lint:fix": "tsc -p tsconfig.json && eslint . --fix --max-warnings 0 && prettier --write . --log-level warn",
    "dist": "rimraf dist && concurrently --kill-others-on-fail npm:dist:*",
    "dist:cjs": "babel src --out-dir dist/cjs --config-file ./babel.cjs.json --extensions .ts,.tsx --no-babelrc",
    "dist:esm": "babel src --out-dir dist/esm --config-file ./babel.esm.json --extensions .ts,.tsx --no-babelrc",
    "dist:umd": "cross-env NODE_ENV=development rollup --config && cross-env NODE_ENV=production rollup --config",
    "dist:types": "tsc -p ./tsconfig.build.json",
    "gh-pages": "npm run build && gh-pages -d build",
    "release": "npm run release:dry-run && HUSKY=0 release-it && npm run gh-pages",
    "release:dry-run": "npm run lint && npm run test && npm run dist && HUSKY=0 release-it --dry-run"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "^7.29.10",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.26",
    "@types/raf": "^3.4.3",
    "@types/use-sync-external-store": "^1.7.0",
    "@types/warning": "^3.0.4",
    "eventemitter3": "^5.0.4",
    "intersection-observer": "^0.12.2",
    "js-cookie": "^3.0.8",
    "lodash": "^4.18.1",
    "lru-cache": "^10.4.3",
    "raf": "^3.4.1",
    "requestidlecallback": "^0.3.0",
    "resize-observer-polyfill": "^1.5.1",
    "use-sync-external-store": "^1.7.0",
    "warning": "^4.0.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@eslint/js": "^10.0.1",
    "@mdx-js/react": "^3.1.1",
    "@release-it/conventional-changelog": "^11.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@sinonjs/fake-timers": "^15.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@tweenjs/tween.js": "^25.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "execa": "^10.1.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prism-react-renderer": "^2.4.1",
    "raw-loader": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "release-it": "^20.2.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.6",
    "rollup-plugin-license": "^3.7.1",
    "tsc-files": "^1.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
